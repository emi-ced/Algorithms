namespace Algorithms.Graph_Algorithms
{
    public class FloydsTortoiseHare
    {
      public int FindCycle(int[] nums)
      {
          var slowPointer = nums[0];
          var fastPointer = nums[0];
  
          while (true)
          {
              slowPointer = nums[slowPointer];
              fastPointer = nums[nums[fastPointer]];
  
              // Found cycle.
              if (slowPointer == fastPointer)
                  break;
          }
  
          // Find start of cycle.
          var newSlowPointer = nums[0];
  
          while (newSlowPointer != slowPointer)
          {
              newSlowPointer = nums[newSlowPointer];
              slowPointer = nums[slowPointer];
          }
  
          return slowPointer;
      }
    }
}

